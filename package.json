{
  "name": "legal-annotation-kit",
  "version": "0.0.0",
  "description": "Vue components for annotating legal documents.",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/legal-annotation-kit.umd.cjs",
  "module": "./dist/legal-annotation-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/legal-annotation-kit.js",
      "require": "./dist/legal-annotation-kit.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.10"
  }
}
